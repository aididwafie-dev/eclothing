<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <staticContent>
      <!-- IIS refuses to serve an extension it has no MIME type for, and the
           web app manifest is not in its default list. remove first so this
           still loads if the type is ever defined at server level. -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Next.js UI scaffold, reverse proxied via ARR to the local
             next start process. Lives under its own path prefix so it
             never shadows a real Laravel route while the rewrite is
             being built out page by page. See frontend/README.md.
             The full matched path (R:0), prefix included, is forwarded
             as-is: Next's own basePath config strips it internally for
             routing, and needs it intact to emit correctly-prefixed
             asset and navigation links in the HTML it returns. -->
        <rule name="Next.js UI preview" stopProcessing="true">
          <match url="^next-preview(/.*)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:0}" />
        </rule>
        <rule name="Imported Rule 1" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <rule name="Imported Rule 2" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
